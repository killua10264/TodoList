{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "TodoListBackend",
    "Audience": "TodoListFrontend",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CloudinarySettings": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "RefreshToken": {
    "ExpiryDays": 7,
    "CookieName": "todo_refresh_token",
    "CookiePath": "/api/auth",
    "SameSite": "Lax",
    "Secure": true
  }
}
